set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(NOT DEFINED ${EPUB_TOOLCHAIN_ROOT_VARIABLE} OR "${${EPUB_TOOLCHAIN_ROOT_VARIABLE}}" STREQUAL "")
    message(FATAL_ERROR "Set ${EPUB_TOOLCHAIN_ROOT_VARIABLE} to the installed ${EPUB_TOOLCHAIN_TRIPLE} toolchain")
endif()
get_filename_component(EPUB_TOOLCHAIN_ROOT "${${EPUB_TOOLCHAIN_ROOT_VARIABLE}}" ABSOLUTE)
set(${EPUB_TOOLCHAIN_ROOT_VARIABLE} "${EPUB_TOOLCHAIN_ROOT}" CACHE PATH
    "Installed ${EPUB_TOOLCHAIN_TRIPLE} toolchain" FORCE)
foreach(tool gcc g++ ar ranlib strip)
    if(NOT EXISTS "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-${tool}")
        message(FATAL_ERROR "${EPUB_TOOLCHAIN_ROOT_VARIABLE} is missing bin/${EPUB_TOOLCHAIN_TRIPLE}-${tool}")
    endif()
endforeach()

set(CMAKE_C_COMPILER "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-gcc")
set(CMAKE_CXX_COMPILER "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-g++")
set(CMAKE_AR "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-ar")
set(CMAKE_RANLIB "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-ranlib")
set(CMAKE_STRIP "${EPUB_TOOLCHAIN_ROOT}/bin/${EPUB_TOOLCHAIN_TRIPLE}-strip")
set(CMAKE_C_FLAGS_INIT "${EPUB_TOOLCHAIN_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${EPUB_TOOLCHAIN_FLAGS}")

set(CMAKE_SYSROOT "${EPUB_TOOLCHAIN_ROOT}/${EPUB_TOOLCHAIN_TRIPLE}/sysroot")
if(NOT IS_DIRECTORY "${CMAKE_SYSROOT}")
    message(FATAL_ERROR "${EPUB_TOOLCHAIN_ROOT_VARIABLE} is missing its sysroot: ${CMAKE_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ${EPUB_TOOLCHAIN_ROOT_VARIABLE})
